# Braid environment contract
# No real value should be committed. Copy to .env and fill per deployment.

# ElevenLabs platform
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Webhook shared secret used to sign and verify post-call events (HMAC SHA-256)
BRAID_WEBHOOK_SECRET=change-me-in-deployment

# Storage. The challenge build runs an in-memory repository seeded with synthetic records.
# To persist, set DATABASE_URL to a Postgres instance and apply the migrations in db/migrations.
DATABASE_URL=

# Sandbox dependencies. The challenge build uses internal synthetic adapters.
CLAIMS_SANDBOX_URL=internal
REPAIR_SANDBOX_URL=internal
# Set to false to demonstrate the dependency failure path live.
CLAIMS_SANDBOX_AVAILABLE=true

# Session and demo access
SESSION_SIGNING_SECRET=change-me-in-deployment
BRAID_DEMO_TOKEN=braid-demo-token
# Optional reviewer token. When set, GET /api/evaluations requires it.
REVIEWER_TOKEN=

# Observability
POSTHOG_KEY=
SENTRY_DSN=

# Deployment
BRAID_DEPLOYMENT_URL=http://localhost:3000
API_PORT=4000

# Web app
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_DEMO_TOKEN=braid-demo-token
