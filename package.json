{
  "name": "braid",
  "private": true,
  "version": "1.0.0",
  "description": "Braid, a multilingual insurance claims evidence reconciliation agent for the Future of Voice AI Challenge",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  }
}
